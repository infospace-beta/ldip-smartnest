NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_API_URL=https://api.your-domain.example/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
# Leave false in staging. Only the public homepage is included in the sitemap.
SMARTNEST_PUBLIC_INDEXING=false
# OAuth and SMS private credentials belong in Supabase/backend secrets, never here.
