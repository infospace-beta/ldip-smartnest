-- Run against a NEW dedicated database using your provider's administrative role.
-- Review managed-provider restrictions first. This file is not executed automatically.
-- The \password commands prompt securely; no passwords belong in this file.
CREATE ROLE smartnest_migrator LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE;
CREATE ROLE smartnest_app LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE;
\password smartnest_migrator
\password smartnest_app
CREATE DATABASE smartnest OWNER smartnest_migrator;
REVOKE ALL ON DATABASE smartnest FROM PUBLIC;
GRANT CONNECT ON DATABASE smartnest TO smartnest_app, smartnest_migrator;
\connect smartnest
REVOKE CREATE ON SCHEMA public FROM PUBLIC;
SET ROLE smartnest_migrator;
CREATE SCHEMA app AUTHORIZATION smartnest_migrator;
GRANT USAGE ON SCHEMA app TO smartnest_app;
ALTER DEFAULT PRIVILEGES FOR ROLE smartnest_migrator IN SCHEMA app
    GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO smartnest_app;
ALTER DEFAULT PRIVILEGES FOR ROLE smartnest_migrator IN SCHEMA app
    GRANT USAGE, SELECT ON SEQUENCES TO smartnest_app;
RESET ROLE;
-- Run Django migrate with DB_USER=smartnest_migrator and DB_SCHEMA=app.
-- Run the web service/worker with DB_USER=smartnest_app and DB_SCHEMA=app.
-- For an EXISTING database, migrate ownership/default privileges separately;
-- never run a database reset or drop as part of routine deployment.
