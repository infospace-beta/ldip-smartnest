# Install as /etc/smartnest/backup.env, mode 0600, owned by root.
# Keep the encryption key separately from backups and outside the web service.
SMARTNEST_BACKUP_KEY=replace-with-private-fernet-key
SMARTNEST_OFFSITE_DEST=your-rclone-remote:smartnest-encrypted-backups
RCLONE_CONFIG=/etc/smartnest/rclone.conf
