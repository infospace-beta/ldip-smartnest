# Free pilot: durable PostgreSQL and private object storage are hosted separately.
# Idle services sleep; automation resumes when the service wakes.
services:
  - type: web
    name: smartnest-api
    runtime: python
    plan: free
    numInstances: 1
    buildCommand: pip install -r backend/requirements.txt && python backend/manage.py collectstatic --noinput
    startCommand: python -B deploy/render-start.py
    healthCheckPath: /api/health/ready/
    envVars:
      - key: PYTHON_VERSION
        value: 3.14.0
      - key: DJANGO_ENV
        value: production
      - key: DEBUG
        value: 'false'
      - key: DJANGO_TRUST_PROXY_HTTPS
        value: 'true'
      - key: SMARTNEST_MEDIA_BACKEND
        value: s3
      - key: PGSSLROOTCERT
        value: /opt/render/project/src/deploy/supabase/prod-ca-2021.crt
      - key: DJANGO_MEDIA_ROOT
        value: /tmp/smartnest-unused-media
      - key: DJANGO_STATIC_ROOT
        value: /opt/render/project/src/staticfiles
      - key: AUTOMATION_HEARTBEAT_PATH
        value: /tmp/smartnest/worker/heartbeat
      - key: SMARTNEST_SMS_ENABLED
        value: 'false'
      - key: DARAJA_SANDBOX_ENABLED
        value: 'false'
      - key: DJANGO_SECRET_KEY
        sync: false
      - key: NOTICE_ENCRYPTION_KEYS
        sync: false
      - key: DJANGO_ALLOWED_HOSTS
        sync: false
      - key: FRONTEND_URL
        sync: false
      - key: DJANGO_CORS_ORIGINS
        sync: false
      - key: DJANGO_CSRF_ORIGINS
        sync: false
# Set DB_*, private S3 credentials, Supabase and SMTP variables from .env.production.example in Render.
# Provision managed PostgreSQL separately and run migrations using its maintenance
# identity before starting this service. No database or paid resource is created here.
