[Unit]
OnFailure=smartnest-alert@%n.service
Description=SmartNest frontend
After=network-online.target

[Service]
User=smartnest
Group=smartnest
WorkingDirectory=/opt/smartnest/frontend
Environment=NODE_ENV=production
EnvironmentFile=/etc/smartnest/frontend.env
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/smartnest/frontend/.next/cache

[Install]
WantedBy=multi-user.target
