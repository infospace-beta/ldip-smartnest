DJANGO_ENV=production
DEBUG=false
DJANGO_SECRET_KEY=replace-with-at-least-50-private-random-characters
NOTICE_ENCRYPTION_KEYS=replace-with-private-fernet-key
DJANGO_ALLOWED_HOSTS=api.your-domain.example
FRONTEND_URL=https://your-domain.example
DJANGO_CORS_ORIGINS=https://your-domain.example
DJANGO_CSRF_ORIGINS=https://your-domain.example
DJANGO_TRUST_PROXY_HTTPS=true
DJANGO_HSTS_SUBDOMAINS=false
# Enable preload only after validating every HTTPS subdomain and the preload policy.
DJANGO_HSTS_PRELOAD=false
DJANGO_MEDIA_ROOT=/var/lib/smartnest/media
DJANGO_STATIC_ROOT=/var/lib/smartnest/static
AUTOMATION_HEARTBEAT_PATH=/var/lib/smartnest/worker/heartbeat
AUTOMATION_HEARTBEAT_MAX_AGE=180
DB_NAME=smartnest
DB_SCHEMA=app
DB_USER=smartnest_app
DB_PASSWORD=replace-with-private-random-password
DB_HOST=private-database-host
DB_PORT=5432
DB_SSLMODE=verify-full
PGSSLROOTCERT=/etc/smartnest/database-ca.pem
SUPABASE_AUTH_ENABLED=true
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
# Backup key belongs in a separate restricted backup environment, not the web service.
# SMARTNEST_BACKUP_KEY=private-fernet-key-stored-separately-from-backup-files

# Optional notification SMS; Supabase phone OTP is configured separately.
SMARTNEST_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Sandbox-only Daraja. Real payments remain unsupported.
DARAJA_SANDBOX_ENABLED=false
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_BASE_URL=

# Transactional application email (Supabase SMTP is configured separately).
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=replace-with-smtp-host
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=SmartNest <no-reply@your-domain.example>
# Service-failure alerts; use a monitored operations inbox.
SMARTNEST_ALERT_EMAIL=operations@your-domain.example
